+namespace fnvmoe {
+// Local Prompt 14 A/B gate. Never changes a graph after capture.
+inline bool candidate = [] { const char* p=std::getenv("FNV_Q4_SMALL_ROW"); return p && std::string_view(p)=="1"; }();
+inline thread_local bool verification=false;
+struct VerifyScope { bool before; explicit VerifyScope(bool on):before(verification){verification=on;} ~VerifyScope(){verification=before;} };
+using Counts=std::array<std::uint64_t,5>; // baseline, candidate, candidate2, candidate3, fallback
+struct Round {unsigned rows{}; double wall_ms{},wait_ms{},ple_ms{};};
+struct State {bool active{};Counts executed{},capture_calls{};unsigned rounds{},overflow{},missing_template{},replays{},captures{};std::array<Round,512> round{};};
+inline State state;
+inline std::map<std::uint64_t,Counts> graph_counts;
+inline void Reset(){state={};state.active=true;}
+inline bool Use(int tokens){return candidate && verification && (tokens==2 || tokens==3);}
+inline void Note(int tokens,bool selected){if(!state.active || !verification)return;
+  if(selected){++state.executed[1];++state.executed[tokens==2?2:3];}
+  else {++state.executed[0];if(tokens!=2 && tokens!=3)++state.executed[4];}
+}
+inline bool VerifyKey(std::uint64_t k){return (k&(1ULL<<32)) && !(k&(1ULL<<40));}
+inline void Capture(std::uint64_t key,const Counts& before){if(!state.active || !VerifyKey(key))return;
+  Counts delta{};for(unsigned i=0;i<5;++i){delta[i]=state.executed[i]-before[i];state.capture_calls[i]+=delta[i];}
+  graph_counts[key]=delta;state.executed=before;++state.captures;
+}
+inline void Replay(std::uint64_t key){if(!state.active || !VerifyKey(key))return;
+  ++state.replays;auto it=graph_counts.find(key);if(it==graph_counts.end()){++state.missing_template;return;}
+  for(unsigned i=0;i<5;++i)state.executed[i]+=it->second[i];
+}
+}
