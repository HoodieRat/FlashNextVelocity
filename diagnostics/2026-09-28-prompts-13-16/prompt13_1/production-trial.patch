+#pragma once
+namespace fnvcontract {
+struct Slot{hipEvent_t start{},stop{};int sample{-1};double launch_start{};};
+inline std::array<Slot,8> pool{};
+inline unsigned created=0;inline bool ready=false,broken=false;
+inline void CollectEvents(){
+  if(!Active())return;
+  unsigned pending=0;
+  for(auto& p:pool){if(p.sample==-1)continue;
+    if(p.sample==-2){if(hipEventQuery(p.start)==hipSuccess && hipEventQuery(p.stop)==hipSuccess){float ignored; if(hipEventElapsedTime(&ignored,p.start,p.stop)!=hipErrorNotReady)p.sample=-1;}continue;}
+    auto& s=state.sample[p.sample];
+    const auto b=hipEventQuery(p.start),e=hipEventQuery(p.stop);
+    s.start_query=static_cast<int>(b);s.stop_query=static_cast<int>(e);
+    if(b==hipErrorNotReady || e==hipErrorNotReady){++s.query_not_ready;++pending;continue;}
+    float ms=std::numeric_limits<float>::quiet_NaN();
+    auto status=hipEventElapsedTime(&ms,p.start,p.stop);s.elapsed_status=static_cast<int>(status);
+    if(status==hipErrorNotReady){++s.elapsed_not_ready;++pending;continue;}
+    s.raw_ms=ms;s.finite=std::isfinite(ms);s.positive=ms>0;s.consumed=true;p.sample=-1;
+  }
+  state.pending=pending;
+}
+inline void PrepareEvents(){
+  state.runtime_status=static_cast<int>(hipRuntimeGetVersion(&state.runtime_version));
+  GetModuleFileNameA(GetModuleHandleA("amdhip64_7.dll"),state.loaded_module,MAX_PATH);
+  if(!ready && !broken){for(auto& p:pool){
+    auto x=hipEventCreateWithFlags(&p.start,hipEventDefault);
+    if(x!=hipSuccess){state.create_status=x;broken=true;break;}++created;
+    x=hipEventCreateWithFlags(&p.stop,hipEventDefault);
+    if(x!=hipSuccess){state.create_status=x;broken=true;break;}++created;
+  }ready=!broken;}
+  state.created=created;
+}
+inline void Complete(){
+  const double now=Qpc();
+  // Completion is an existing dependency; timestamp before querying timers.
+  for(auto& p:pool)if(p.sample>=0 && state.sample[p.sample].completion_wall_ms==0)
+    state.sample[p.sample].completion_wall_ms=now-p.launch_start;
+  CollectEvents();
+}
+inline void FinishEvents(){Complete();for(auto& p:pool)if(p.sample>=0)p.sample=-2;}
+inline void ReleaseEvents(){for(auto& p:pool){if(p.start)(void)hipEventDestroy(p.start);if(p.stop)(void)hipEventDestroy(p.stop);p={};}ready=false;created=0;}
+struct Replay{
+  Slot* slot{};int sample{-1};double start{};
+  Replay(hipStream_t stream,std::uint64_t key){
+    if(!Active() || !(key&(1ULL<<32)) || (key&(1ULL<<40)))return;
+    if(!ready || state.samples>=state.sample.size()){++state.overflow;return;}
+    for(auto& p:pool)if(p.sample==-1){slot=&p;break;}
+    if(!slot){++state.overflow;return;}
+    sample=static_cast<int>(state.samples++);slot->sample=sample;
+    auto& s=state.sample[sample];s.key=key;
+    s.start_record=static_cast<int>(hipEventRecord(slot->start,stream));
+    start=Qpc();slot->launch_start=start;
+  }
+  void End(hipStream_t stream){if(!slot)return;auto& s=state.sample[sample];
+    s.launch_host_ms=Qpc()-start;s.stop_record=static_cast<int>(hipEventRecord(slot->stop,stream));
+    unsigned n=0;for(auto& p:pool)n+=p.sample>=0;state.peak=std::max(state.peak,n);
+  }
+};
+struct Install{Install(){Prepare=PrepareEvents;Collect=Complete;Finish=FinishEvents;}};
+inline Install install;
+}
