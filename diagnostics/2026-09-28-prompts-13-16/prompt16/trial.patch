+constexpr int kQsaEventCap = 384;
+
+struct QsaPool {
+  hipEvent_t events[kQsaEventCap]{};
+  bool ready{false};
+  bool broken{false};
+  int cursor{0};
+  int pending_begin{-1};
+  int pending_kind{0};
+  struct Span {
+    std::uint16_t begin{0};
+    std::uint16_t end{0};
+    std::uint8_t kind{0};
+  };
+  std::vector<Span> open;
+  std::unordered_map<std::uint64_t, std::vector<Span>> saved;
+  std::vector<std::uint64_t> deferred;
+};
+
+QsaPool& Qsa() {
+  static QsaPool pool;
+  return pool;
+}
+
+void QsaAbandon() {
+  auto& pool = Qsa();
+  pool.cursor = 0;
+  pool.pending_begin = -1;
+  pool.open.clear();
+  pool.deferred.clear();
+}
+
+struct QsaInstall {
+  QsaInstall() { fnvprof::OnReset = QsaAbandon; }
+};
+QsaInstall qsa_install;
+
+void QsaEnsure() {
+  auto& pool = Qsa();
+  if (pool.ready || pool.broken) return;
+  for (int i = 0; i < kQsaEventCap; ++i) {
+    if (hipEventCreate(&pool.events[i]) != hipSuccess) {
+      pool.broken = true;
+      fnvprof::SetQsaFailed();
+      return;
+    }
+  }
+  pool.ready = true;
+}
+
+void QsaBeginHost() {
+  auto& pool = Qsa();
+  pool.open.clear();
+  pool.pending_begin = -1;
+}
+
+bool QsaArm(hipStream_t stream, int kind) {
+  if (!fnvprof::OnDecode()) return false;
+  hipStreamCaptureStatus capture = hipStreamCaptureStatusNone;
+  if (hipStreamIsCapturing(stream, &capture) == hipSuccess &&
+      capture == hipStreamCaptureStatusActive) {
+    // Event nodes inside a capture can invalidate the graph. Skip them.
+    fnvprof::SetQsaCaptureSkipped();
+    return false;
+  }
+  auto& pool = Qsa();
+  if (!pool.ready || pool.cursor + 2 > kQsaEventCap) {
+    if (pool.ready) fnvprof::SetQsaTruncated();
+    return false;
+  }
+  const int begin = pool.cursor++;
+  if (hipEventRecord(pool.events[begin], stream) != hipSuccess) {
+    fnvprof::SetQsaFailed();
+    return false;
+  }
+  pool.pending_begin = begin;
+  pool.pending_kind = kind;
+  return true;
+}
+
+void QsaFinish(hipStream_t stream) {
+  auto& pool = Qsa();
+  if (pool.pending_begin < 0) return;
+  const int end = pool.cursor++;
+  if (hipEventRecord(pool.events[end], stream) != hipSuccess) {
+    fnvprof::SetQsaFailed();
+    pool.pending_begin = -1;
+    return;
+  }
+  QsaPool::Span span;
+  span.begin = static_cast<std::uint16_t>(pool.pending_begin);
+  span.end = static_cast<std::uint16_t>(end);
+  span.kind = static_cast<std::uint8_t>(pool.pending_kind);
+  pool.open.push_back(span);
+  pool.pending_begin = -1;
+}
+
+void QsaEndHost(std::uint64_t key) {
+  auto& pool = Qsa();
+  pool.saved[key] = pool.open;
+  pool.open.clear();
+  pool.pending_begin = -1;
+}
+
+void QsaQuery(const std::vector<QsaPool::Span>& spans) {
+  auto& pool = Qsa();
+  for (const auto& span : spans) {
+    float ms = 0;
+    if (hipEventElapsedTime(&ms, pool.events[span.begin],
+                            pool.events[span.end]) != hipSuccess ||
+        !(ms >= 0.0F)) {
+      fnvprof::SetQsaFailed();
+      continue;
+    }
+    fnvprof::AddQsa(span.kind, static_cast<double>(ms));
+  }
+}
+
+void QsaDefer(std::uint64_t key) { Qsa().deferred.push_back(key); }
+
+void QsaCollect(std::uint64_t key) {
+  auto& pool = Qsa();
+  for (const auto deferred : pool.deferred) {
+    const auto found = pool.saved.find(deferred);
+    if (found != pool.saved.end()) QsaQuery(found->second);
+  }
+  pool.deferred.clear();
+  const auto found = pool.saved.find(key);
+  if (found != pool.saved.end()) QsaQuery(found->second);
+  pool.cursor = 0;
+}
