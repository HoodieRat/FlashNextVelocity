-
-bool Executor::DownloadVerificationRow(std::uint32_t row,
-                                       std::string* error_msg) const {
-  const Config& c = config();
-  if (row >= options_.max_logit_rows || logits_host_ == nullptr) {
-    AssignError(error_msg, "verification row download is outside the logit buffer");
-    return false;
-  }
-  auto* destination =
-      logits_host_ + static_cast<std::size_t>(row) * c.vocab_size;
-  VerifyGpuSpan d2h_span(stream_, fnvprof::VerifySubstage::D2H,
-                         fnvprof::OnDecode());
-  if (!Check(hipMemcpyAsync(
-                 destination,
-                 VerificationLogits() + static_cast<std::size_t>(row) *
-                                            c.vocab_size,
-                 static_cast<std::size_t>(c.vocab_size) * sizeof(float),
-                 hipMemcpyDeviceToHost, stream_),
-             "verification fallback row download", error_msg)) {
-    return false;
-  }
-  d2h_span.Finish();
-  if (!Check(fnvprof::TimedStreamSync(stream_, hipStreamSynchronize),
-             "verification fallback row", error_msg)) {
-    return false;
-  }
-  VerifyGpuCollect();
-  fnvprof::AddVerificationTransfer(
-      1, 0, static_cast<std::uint64_t>(c.vocab_size) * sizeof(float), 0);
-  return true;
-}
-
-bool Executor::DownloadRetainedFrontier(const Session& session, float* logits,
-                                        std::string* error_msg) const {
-  const Config& c = config();
-  if (session.owner_ != this || !session.mtp_enabled_ ||
-      session.mtp_.frontier_logits == nullptr || logits == nullptr) {
-    AssignError(error_msg, "retained verification frontier is unavailable");
-    return false;
-  }
-  VerifyGpuSpan d2h_span(stream_, fnvprof::VerifySubstage::D2H,
-                         fnvprof::OnDecode());
-  if (!Check(hipMemcpyAsync(logits_host_, session.mtp_.frontier_logits,
-                            static_cast<std::size_t>(c.vocab_size) *
-                                sizeof(float),
-                            hipMemcpyDeviceToHost, stream_),
-             "retained verification frontier download", error_msg)) {
-    return false;
-  }
-  d2h_span.Finish();
-  if (!Check(fnvprof::TimedStreamSync(stream_, hipStreamSynchronize),
-             "retained verification frontier", error_msg)) {
-    return false;
-  }
-  VerifyGpuCollect();
-  fnvprof::AddVerificationTransfer(
-      1, 0, static_cast<std::uint64_t>(c.vocab_size) * sizeof(float), 0);
-  std::copy_n(logits_host_, c.vocab_size, logits);
-  return true;
-}
-
-bool Executor::Rollback(Session& session, std::uint32_t keep,
-                        std::string* error_msg, float* logits) const {
-  const Config& c = config();
-  const std::uint32_t n = session.spec_tokens_;
-  if (n == 0 || keep == 0 || keep > n) {
-    AssignError(error_msg, "rollback outside the pending speculative batch");
-    return false;
-  }
-  session.spec_tokens_ = 0;
-  VerifyGpuSpan rollback_d2h(stream_, fnvprof::VerifySubstage::D2H,
-                              logits != nullptr && fnvprof::OnDecode());
-  if (logits != nullptr &&
-      !Check(hipMemcpyAsync(
-                 logits_host_,
-                 VerificationLogits() +
-                     static_cast<std::size_t>(keep - 1) * c.vocab_size,
-                 c.vocab_size * sizeof(float), hipMemcpyDeviceToHost, stream_),
-             "frontier download", error_msg)) {
-    return false;
-  }
-  if (logits != nullptr) {
-    rollback_d2h.Finish();
-    fnvprof::AddVerificationTransfer(
-        1, 0, static_cast<std::uint64_t>(c.vocab_size) * sizeof(float), 0);
-  }
-  if (keep == n && logits == nullptr) {
-    return true;
-  }
-  if (keep < n) {
-    const std::size_t conv_elems =
-        static_cast<std::size_t>(c.ssm_conv_kernel - 1) * c.SsmConvChannels();
-    const std::size_t slot = keep - 1;
-    for (auto& l : session.linear_) {
-      if (l.state == nullptr) {
-        continue;
-      }
-      RestoreGdnState(l.state, l.state_snapshots, keep, c.ssm_num_k_heads,
-                      c.ssm_num_v_heads, stream_);
-      if (!Check(hipGetLastError(), "state rollback", error_msg) ||
-          !Check(hipMemcpyAsync(l.conv_state, l.conv_snapshots.rows[slot],
-                                conv_elems * sizeof(float),
-                                hipMemcpyDeviceToDevice, stream_),
-                 "conv rollback", error_msg)) {
-        return false;
-      }
-    }
-    if (session.ple_history_ != nullptr) {
-      const std::size_t hist =
-          static_cast<std::size_t>(c.PleConvHistory()) * c.HcDim();
-      if (!Check(hipMemcpyAsync(
-                     session.ple_history_, session.ple_snapshots_.rows[slot],
-                     hist * sizeof(float), hipMemcpyDeviceToDevice, stream_),
-                 "PLE rollback", error_msg)) {
-        return false;
-      }
-      session.ngram_ = session.ngram_snapshots_[slot];
-    }
-    session.position_ = session.spec_base_ + keep;
-    // Pooled block keys past the kept prefix are stale; they are rebuilt
-    // from the raw keys when needed.
-    session.blocks_ =
-        c.compress_ratio == 0
-            ? 0
-            : std::min(session.blocks_, session.position_ / c.compress_ratio);
-  }
-  // Device-only restores are ordered by the same nonblocking stream as the
-  // next decode. Do not stall the host merely to observe completion. A host
-  // frontier request still synchronizes because the caller consumes it now.
-  if (logits == nullptr) {
-    return true;
-  }
-  if (!Check(fnvprof::TimedStreamSync(stream_, hipStreamSynchronize),
-             "rollback frontier", error_msg)) {
-    return false;
-  }
-  VerifyGpuCollect();
-  std::copy_n(logits_host_, c.vocab_size, logits);
-  return true;
-}
-
-constexpr std::array<char, 8> kSnapshotMagic{'Q', 'F', 'N', 'S',
-                                             'N', 'A', 'P', '4'};
-
-/// Fixed header ahead of the section bytes. It carries every geometry
-/// value the section sizes derive from, so a payload of another artifact
-/// or executor configuration is rejected before anything is copied.
-struct SnapshotHeader {
-  std::array<char, 8> magic;
-  std::uint32_t num_layers;
-  std::uint32_t full_attention_interval;
-  std::uint32_t conv_elems;
-  std::uint32_t state_elems;
-  std::uint32_t kv_row;
-  std::uint32_t indexer_head_dim;
-  std::uint32_t compress_ratio;
-  std::uint32_t hc_dim;
-  std::uint32_t ple_elems;
