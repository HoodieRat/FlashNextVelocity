+struct QsaSpan {
+  hipStream_t stream{nullptr};
+  bool active{false};
+  QsaSpan(hipStream_t stream_in, int kind, bool enable) : stream(stream_in) {
+    if (enable) active = QsaArm(stream, kind);
+  }
+  ~QsaSpan() {
+    if (active) QsaFinish(stream);
+  }
+  QsaSpan(const QsaSpan&) = delete;
+  QsaSpan& operator=(const QsaSpan&) = delete;
+};
