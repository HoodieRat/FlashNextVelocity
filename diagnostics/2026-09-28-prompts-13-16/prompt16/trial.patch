+// Exact shared-expert down shape only. No elapsed-event measurements.
+#include "src/models/qwen38_flash_next/kernels/rocm/mmq/qfn_mmq.h"
+#include "src/models/qwen38_flash_next/kernels/rocm/mmq/shared_down.hpp"
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+constexpr int kM = 2560, kK = 640;
+constexpr size_t kGuard = 64;
+constexpr float kPoison = -1234567.0F;
+constexpr unsigned char kByteGuard = 0xA5;
+struct Q8Weight { uint16_t d; int8_t qs[32]; };
+static_assert(sizeof(Q8Weight) == 34);
+
+void Hip(hipError_t error, const char* operation) {
+  if (error != hipSuccess)
+    throw std::runtime_error(std::string(operation) + ": " + hipGetErrorString(error));
+}
+void Api(int error, const char* operation) {
+  if (error) throw std::runtime_error(std::string(operation) + " returned " + std::to_string(error));
+}
+struct Memory {
+  std::vector<void*> pointers;
+  ~Memory() { for (void* p : pointers) (void)hipFree(p); }
+  template<class T> T* Upload(const std::vector<T>& values) {
+    T* p{};
+    Hip(hipMalloc(&p, values.size()*sizeof(T)), "allocate");
+    pointers.push_back(p);
+    Hip(hipMemcpy(p, values.data(), values.size()*sizeof(T), hipMemcpyHostToDevice), "upload");
+    return p;
+  }
+};
+struct Graph {
+  hipGraph_t graph{};
+  hipGraphExec_t exec{};
+  ~Graph() {
+    if (exec) (void)hipGraphExecDestroy(exec);
+    if (graph) (void)hipGraphDestroy(graph);
+  }
+  std::vector<uintptr_t> KernelFunctions() const {
+    size_t count{};
+    Hip(hipGraphGetNodes(graph, nullptr, &count), "graph node count");
+    std::vector<hipGraphNode_t> nodes(count);
+    Hip(hipGraphGetNodes(graph, nodes.data(), &count), "graph nodes");
+    std::vector<uintptr_t> functions;
+    for (auto node : nodes) {
+      hipGraphNodeType type{};
+      Hip(hipGraphNodeGetType(node, &type), "node type");
+      if (type != hipGraphNodeTypeKernel) throw std::runtime_error("unexpected non-kernel graph node");
+      hipKernelNodeParams params{};
+      Hip(hipGraphKernelNodeGetParams(node, &params), "kernel parameters");
+      functions.push_back(reinterpret_cast<uintptr_t>(params.func));
+    }
+    std::sort(functions.begin(), functions.end());
+    return functions;
+  }
+};
+template<class T> std::vector<T> Read(const T* p, size_t count) {
+  std::vector<T> values(count);
+  Hip(hipMemcpy(values.data(), p, count*sizeof(T), hipMemcpyDeviceToHost), "read");
+  return values;
+}
+uint32_t Next(uint32_t& s) { s ^= s << 13; s ^= s >> 17; s ^= s << 5; return s; }
+
+void CheckShape(int n) {
+  Memory memory;
+  std::vector<Q8Weight> weights(size_t(kM)*(kK/32));
+  uint32_t seed = 12345;
+  // Finite binary16 scales, including zero and negative scales.
+  const uint16_t scales[] = {0x2400, 0x2000, 0x2800, 0xA400, 0x0000};
+  for (auto& block : weights) {
+    block.d = scales[Next(seed)%5];
+    for (auto& value : block.qs) value = static_cast<int8_t>(int(Next(seed)%255)-127);
+  }
+  auto* dw = memory.Upload(weights);
+  std::vector<float> input(size_t(n)*kK);
+  auto* dx = memory.Upload(input);
+  const size_t prepared_bytes = qfn_mmq_q8_1_bytes(n, kK);
+  auto* prepared = memory.Upload(std::vector<unsigned char>(prepared_bytes+2*kGuard, kByteGuard));
+  const size_t count = size_t(n)*kM;
+  std::vector<float> dirty(count+2*kGuard, kPoison);
+  std::array<float*,4> output{};
+  for (auto& p : output) p = memory.Upload(dirty);
+  hipStream_t stream{};
+  Hip(hipStreamCreate(&stream), "stream");
+  std::array<Graph,4> graphs;
+  // 0 baseline; 1 candidate with both scopes; 2 candidate enabled without
+  // shared scope; 3 direct existing MMVQ reference. All use the same shape.
+  const auto launch = [&](int mode) {
+    Api(qfn_mmq_quantize_q8_1(dx, prepared+kGuard, n, kK, stream), "prepare FP32 activation");
+    fnvdown::candidate = mode == 1 || mode == 2;
+    fnvdown::VerifyScope verification(true);
+    if (mode == 3) {
+      Api(qfn_q8_mmvq_reference(dw, nullptr, prepared+kGuard, output[mode]+kGuard,
+                                kM, n, kK, stream), "direct MMVQ reference");
+    } else if (mode != 2) {
+      fnvdown::SharedScope shared;
+      Api(qfn_mmq_q8_0_dense_vec_preq(dw, nullptr, prepared+kGuard, output[mode]+kGuard,
+                                     kM, n, kK, stream), "scoped shared-down projection");
+    } else {
+      Api(qfn_mmq_q8_0_dense_vec_preq(dw, nullptr, prepared+kGuard, output[mode]+kGuard,
+                                     kM, n, kK, stream), "unscoped fallback projection");
+    }
+  };
+  for (int mode = 0; mode < 4; ++mode) {
+    launch(mode);
+    Hip(hipStreamSynchronize(stream), "warm completion");
+    Hip(hipStreamBeginCapture(stream, hipStreamCaptureModeThreadLocal), "capture");
+    launch(mode);
+    Hip(hipStreamEndCapture(stream, &graphs[mode].graph), "end capture");
+    Hip(hipGraphInstantiate(&graphs[mode].exec, graphs[mode].graph, nullptr, nullptr, 0), "instantiate");
+  }
+  const auto baseline_functions = graphs[0].KernelFunctions();
+  const auto candidate_functions = graphs[1].KernelFunctions();
+  if (baseline_functions.size() != 2 || candidate_functions.size() != 2 ||
+      baseline_functions == candidate_functions ||
+      graphs[2].KernelFunctions() != baseline_functions ||
+      graphs[3].KernelFunctions() != candidate_functions)
+    throw std::runtime_error("graph kernel identities do not prove intended dispatch and fallback");
+  std::vector<float> previous;
+  for (int replay = 0; replay < 3; ++replay) {
+    for (float& x : input) {
+      const float random = float(int(Next(seed)&65535)-32768)/32768.0F;
+      x = replay == 0 ? 0.0F : random*(replay == 1 ? 1.0F/128.0F : 2.0F);
+    }
+    Hip(hipMemcpy(dx, input.data(), input.size()*sizeof(float), hipMemcpyHostToDevice), "mutate FP32 source");
+    for (auto* p : output)
+      Hip(hipMemcpy(p, dirty.data(), dirty.size()*sizeof(float), hipMemcpyHostToDevice), "poison output");
+    Api(qfn_mmq_quantize_q8_1(dx, prepared+kGuard, n, kK, stream), "prepare expected bytes");
+    Hip(hipStreamSynchronize(stream), "expected preparation complete");
+    const auto expected_prepared = Read(prepared, prepared_bytes+2*kGuard);
+    for (auto& graph : graphs) Hip(hipGraphLaunch(graph.exec, stream), "graph replay");
+    Hip(hipStreamSynchronize(stream), "replay complete");
+    const auto actual_prepared = Read(prepared, prepared_bytes+2*kGuard);
+    if (actual_prepared != expected_prepared) throw std::runtime_error("projection changed prepared activation bytes");
+    for (size_t i = 0; i < kGuard; ++i)
+      if (actual_prepared[i] != kByteGuard || actual_prepared[kGuard+prepared_bytes+i] != kByteGuard)
+        throw std::runtime_error("prepared activation guard overwritten");
+    std::vector<float> reference;
+    for (int mode = 0; mode < 4; ++mode) {
+      const auto values = Read(output[mode], dirty.size());
+      for (size_t i = 0; i < values.size(); ++i) {
+        if (i < kGuard || i >= kGuard+count) {
+          if (values[i] != kPoison) throw std::runtime_error("output guard overwritten");
+        } else if (!std::isfinite(values[i]) || values[i] == kPoison || (replay == 0 && values[i] != 0.0F)) {
+          throw std::runtime_error("invalid projection output");
+        }
+      }
+      if (mode == 0) reference = values;
+      else if (std::memcmp(reference.data(), values.data(), values.size()*sizeof(float)))
+        throw std::runtime_error("shared-down output differs bitwise for mode " + std::to_string(mode));
+    }
+    if (!previous.empty() && !std::memcmp(previous.data(), reference.data(), reference.size()*sizeof(float)))
+      throw std::runtime_error("changed FP32 input did not change graph replay output");
+    previous = reference;
+  }
+  fnvdown::candidate = false;
+  Hip(hipStreamDestroy(stream), "destroy stream");
+  std::cout << "PASS shared-down Q8_0 M=2560 K=640 N=" << n
+            << " baseline/candidate/MMVQ/fallback bitwise; graph dispatch identities; "
+               "zero/small/ordinary mutated replay; prepared bytes and output guards\n";
+}
+} // namespace
+
+int main() {
+  try {
+    Hip(hipSetDevice(0), "device");
+    for (int n : {2,3}) CheckShape(n);
+    return 0;
+  } catch (const std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
