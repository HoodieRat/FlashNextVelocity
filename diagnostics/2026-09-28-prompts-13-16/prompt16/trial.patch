-void Session::Reset() {
-  TrimRollback(0);
-  position_ = 0;
-  spec_tokens_ = 0;
-  ngram_.Reset();
-  mtp_.position = 0;
-  mtp_.blocks = 0;
-  const Config& c = owner_->config();
-  for (auto& l : linear_) {
-    if (l.state != nullptr) {
-      (void)hipMemset(l.conv_state, 0,
-                      static_cast<std::size_t>(c.ssm_conv_kernel - 1) *
-                          c.SsmConvChannels() * sizeof(float));
-      (void)hipMemset(l.state, 0,
-                      static_cast<std::size_t>(c.ssm_num_v_heads) *
-                          c.ssm_head_dim * c.ssm_head_dim * sizeof(float));
-    }
-  }
-  blocks_ = 0;
-  if (ple_history_ != nullptr) {
-    (void)hipMemset(ple_history_, 0,
-                    static_cast<std::size_t>(c.PleConvHistory()) * c.HcDim() *
-                        sizeof(float));
-  }
-  // Old draft KV and indexer rows are unreachable once the MTP position is 0.
-  // The carried residual is not: a hidden_row < 0 step reads it directly.
-  if (mtp_.h != nullptr) {
-    (void)hipMemset(mtp_.h, 0, static_cast<std::size_t>(c.HcDim()) * sizeof(float));
-    owner_->CountMtpFreshReset();
-  }
-}
