-static void qfn_mmq_sanitize_f32(float *p, uint64_t n, hipStream_t stream) {
-    if (!p || n == 0) return;
-    qfn_mmq_sanitize_f32_kernel<<<(unsigned)((n + 255u) / 256u), 256, 0, stream>>>(p, n);
-}
