-
-bool Executor::Run(Session& session, std::uint64_t key, bool graph,
-                   const std::function<bool()>& body, std::string* error_msg,
-                   bool synchronize) const {
-  // A batch shape runs eagerly once before it is captured: the first pass
-  // grows the GEMM tier's arena, which capture forbids.
-  // Benchmark profiling uses a separate graph key so event nodes stay off
-  // the steady-state graphs used by normal API inference.
-  const bool profile = fnvprof::OnDecode();
-  if (profile) {
-    key |= fnvprof::kProfileGraphBit;
-    QsaEnsure();
-  }
-  auto finish = [&](bool sync_now) {
-    if (!sync_now) {
-      if (profile) QsaDefer(key);
-      return true;
-    }
-    if (!Check(fnvprof::TimedStreamSync(stream_, hipStreamSynchronize),
-               "forward", error_msg)) {
-      return false;
-    }
-    if (profile) QsaCollect(key);
-    return true;
-  };
-  if (graph && session.warmed_.contains(key)) {
-    hipGraphExec_t exec = nullptr;
-    if (const auto it = session.graphs_.find(key);
-        it != session.graphs_.end()) {
-      exec = it->second;
-    } else {
-      hipGraph_t captured = nullptr;
-      // Frozen peer sessions can copy snapshots on independent nonblocking
-      // streams while the scheduler records this session's decode graph.
-      if (!Check(
-              hipStreamBeginCapture(stream_, hipStreamCaptureModeThreadLocal),
-              "graph capture", error_msg)) {
-        return false;
-      }
-      if (profile) {
-        fnvprof::NoteGraphCapture();
-        QsaBeginHost();
-      }
-      const bool ok = body();
-      if (profile) QsaEndHost(key);
-      if (!Check(hipStreamEndCapture(stream_, &captured), "graph capture end",
-                 error_msg) ||
-          !ok) {
-        if (captured != nullptr) {
-          (void)hipGraphDestroy(captured);
-        }
-        return false;
-      }
-      const bool instantiated =
-          Check(hipGraphInstantiate(&exec, captured, nullptr, nullptr, 0),
-                "graph instantiate", error_msg);
-      (void)hipGraphDestroy(captured);
-      if (!instantiated) {
-        return false;
-      }
-      session.graphs_.emplace(key, exec);
-    }
-    if (!Check(hipGraphLaunch(exec, stream_), "graph launch", error_msg)) {
-      return false;
-    }
-    return finish(synchronize);
-  }
-  if (profile) QsaBeginHost();
-  if (!body()) {
-    return false;
-  }
-  if (profile) QsaEndHost(key);
-  session.warmed_.insert(key);
-  return finish(synchronize);
-}
-
-bool Executor::Forward(Session& session, std::span<const std::int32_t> tokens,
-                       std::uint32_t n_logits, float* logits, ForwardMode mode,
-                       std::string* error_msg, LogitTransfer transfer) const {
-  const bool speculative = mode == ForwardMode::kVerify;
-  if (speculative) VerifyGpuBeginForward();
-  std::uint32_t compact_candidates = 0;
-  switch (transfer) {
-    case LogitTransfer::kCompactVerify64: compact_candidates = 64; break;
-    case LogitTransfer::kCompactVerify128: compact_candidates = 128; break;
-    case LogitTransfer::kCompactVerify256:
-      compact_candidates = kMtpVerificationCandidates;
-      break;
-    default: break;
-  }
-  const bool compact_requested = compact_candidates != 0;
-  // A confidence stop can leave an anchor-only verification pass. There is no
-  // intermediate row to compact in that shape, so degrade the transfer to the
-  // ordinary pinned full frontier instead of treating it as an error. This is
-  // also a defensive fallback for any future compact caller that reaches a
-  // one-row verification shape.
-  const bool compact_verification = compact_requested && n_logits >= 2;
-  const bool pinned_full = transfer == LogitTransfer::kPinnedFull ||
-                           (compact_requested && n_logits == 1);
-  if (!compact_verification) compact_candidates = 0;
-  if (transfer != LogitTransfer::kDefault &&
-      (!speculative || logits != nullptr || n_logits == 0)) {
-    AssignError(error_msg, "verification transfer mode requires GPU-resident speculative logits");
-    return false;
-  }
-  const bool download_logits = logits != nullptr || pinned_full;
-  PrefillPhase phase(mode == ForwardMode::kPrefill);
-  selected_logits_ = nullptr;
-  const Config& c = config();
-  const auto n = static_cast<std::uint32_t>(tokens.size());
-  if (n == 0 || n > options_.max_batch ||
-      (speculative && n > options_.max_speculative)) {
-    AssignError(error_msg, "token batch is empty or exceeds the batch limit");
-    return false;
-  }
-  if (n_logits > n || n_logits > options_.max_logit_rows) {
-    AssignError(error_msg, "requested logit rows exceed the batch or limit");
-    return false;
-  }
-  if (session.owner_ != this || session.position_ + n > session.max_context_) {
-    AssignError(error_msg, "session context is full");
-    return false;
-  }
-  for (auto t : tokens) {
-    if (t < 0 || static_cast<std::uint32_t>(t) >= c.vocab_size) {
-      AssignError(error_msg, "token out of range");
-      return false;
-    }
-  }
-  const std::uint32_t start_pos = session.position_;
-  if (!session.CheckCancellation(error_msg))
-    return false;
-  if (session.mtp_enabled_ && prefill_phase &&
-      session.mtp_.position != start_pos) {
-    AssignError(error_msg,
-                "MTP must consume the preceding frontier before prefill");
-    return false;
-  }
-  if (speculative && !EnsureRollback(session, n - 1, error_msg))
-    return false;
-  ++session.mutation_epoch_;
-  session.spec_base_ = start_pos;
-  session.spec_tokens_ = speculative ? n : 0;
-  if (speculative) {
-    fnvprof::NoteVerifyOutputRows(n_logits);
-    // Transfer counters live outside ForwardBody so graph replay is counted on
-    // every cycle even though replay does not execute the host body.
-    if (compact_verification) {
-      const auto count =
-          std::min<std::size_t>(c.vocab_size, compact_candidates);
-      const auto compact_bytes =
-          offsetof(MtpVerificationCandidateLogits, logits) +
-          count * sizeof(float);
-      // Host-side size is not part of the D2H prefix. Refresh it on every
-      // invocation (including graph replay) so interleaved 64/128/256 graphs
-      // cannot leave stale metadata in the pinned candidate rows.
-      if (mtp_verify_candidates_host_ == nullptr) {
-        AssignError(error_msg, "compact verification host buffer is unavailable");
-        return false;
-      }
-      for (std::uint32_t row = 0; row < n_logits; ++row) {
