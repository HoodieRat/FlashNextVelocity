+struct VerifyGpuPool {
+  hipEvent_t events[kVerifyEventCap]{};
+  bool ready{false};
+  bool broken{false};
+  int cursor{0};
+  struct Span {
+    std::uint8_t begin{0};
+    std::uint8_t end{0};
