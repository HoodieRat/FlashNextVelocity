-bool Executor::MtpForwardQueued(
-    Session& session, std::span<const std::int32_t> tokens,
-    std::int32_t hidden_row, bool token, bool candidates,
-    std::string* error_msg, const float* hidden_source, MtpTrace* trace,
-    const std::int32_t* device_token, std::int32_t chain_slot,
-    bool synchronize) const {
-  const bool device_input = device_token != nullptr;
-  const auto n = device_input ? 1U : static_cast<std::uint32_t>(tokens.size());
-  if (session.owner_ != this ||
-      (!device_input && std::any_of(tokens.begin(), tokens.end(), [&](auto t) {
-        return t < 0 || static_cast<std::uint32_t>(t) >= config().vocab_size;
-      }))) {
-    AssignError(error_msg, "invalid MTP session or token");
-    return false;
-  }
-  if (!session.CheckCancellation(error_msg)) return false;
-  if (!session.mtp_enabled_) {
-    AssignError(error_msg, "no MTP block loaded");
-    return false;
-  }
-  if (trace != nullptr &&
-      !trace->Valid(config().hidden_size, config().HcDim())) {
-    AssignError(error_msg, "invalid MTP trace destinations");
-    return false;
-  }
-  if (n == 0 || n > options_.max_batch ||
-      (device_input && hidden_row >= 0) ||
-      (!device_input && hidden_row < 0 && n != 1) ||
-      (hidden_row >= 0 &&
-       static_cast<std::uint32_t>(hidden_row) + n >
-           (hidden_source ? options_.max_batch : options_.max_speculative))) {
-    AssignError(error_msg, "MTP batch outside the kept hidden rows");
-    return false;
-  }
-  if (candidates && device_input) {
-    AssignError(error_msg, "device-fed MTP chain does not transfer candidates");
-    return false;
-  }
-  const std::uint32_t pos = session.mtp_.position;
-  if (pos + n > session.max_context_) {
-    AssignError(error_msg, "MTP context is full");
-    return false;
-  }
-  ++session.mutation_epoch_;
-  if (!device_input) std::copy(tokens.begin(), tokens.end(), tokens_host_);
-
-  Session::Control* control_source = control_host_;
-  if (chain_slot >= 0) {
-    if (static_cast<std::uint32_t>(chain_slot) >= options_.max_speculative ||
-        mtp_chain_controls_host_ == nullptr || mtp_chain_host_ == nullptr) {
-      AssignError(error_msg, "async MTP chain slot is unavailable");
-      return false;
-    }
-    control_source = mtp_chain_controls_host_ + chain_slot;
-  }
-  control_source->position = session.position_;
-  control_source->blocks = session.blocks_;
-  control_source->mtp_position = pos;
-  control_source->hidden_row = hidden_row;
-  control_source->mtp_blocks = session.mtp_.blocks;
-
-  const auto& c = config();
-  const bool sparse = pos + n > c.indexer_top_k;
-  const auto complete = (pos + n) / c.compress_ratio;
-  const auto pool = sparse ? complete - session.mtp_.blocks : 0;
-  const auto graph_pool = n / c.compress_ratio + 1;
-  const bool graph = trace == nullptr && hidden_source == nullptr && n <= kVecBatch &&
-                     pool <= graph_pool &&
-                     pos + 1 >= session.VisionLayout().PrefixLength();
-  const std::uint64_t slot_key =
-      chain_slot >= 0 ? static_cast<std::uint64_t>(chain_slot + 1) : 0ULL;
-  const std::uint64_t key =
-      static_cast<std::uint64_t>(n) |
-      (static_cast<std::uint64_t>(hidden_row < 0) << 32) |
-      (std::uint64_t{1} << 40) |
-      (std::uint64_t{token} << 41) |
-      (std::uint64_t{candidates} << 43) |
-      (std::uint64_t{sparse} << 44) |
-      (std::uint64_t{device_input} << 45) | (slot_key << 48);
-  std::int32_t* token_device =
-      token && chain_slot >= 0 ? s_.mtp_chain_tokens + chain_slot : nullptr;
-  std::int32_t* token_host =
-      token && chain_slot < 0 ? mtp_token_host_ : nullptr;
-  const auto body = [&] {
-    return MtpBody(session, n, pos, token, candidates, error_msg,
-                   graph ? graph_pool : pool, hidden_source, trace,
-                   device_token, control_source, token_device, token_host);
-  };
-  const bool flag_wait = synchronize && graph && done_flag_ != nullptr;
-  if (!Run(session, key, graph, body, error_msg,
-           synchronize && !flag_wait) ||
-      (flag_wait && !Wait("MTP forward", error_msg))) return false;
-  session.mtp_.position = pos + n;
-  if (sparse) session.mtp_.blocks = complete;
-  return true;
-}
