+
+extern "C" int qfn_mmq_quantize_q8_1(
+        const float * X_f32, void * X_q8, int N, int K, hipStream_t stream) {
+    if (!X_f32 || !X_q8 || N <= 0 || K <= 0 || K % 32 != 0) {
+        fprintf(stderr, "qfn_mmq_quantize_q8_1: bad arguments N=%d K=%d\n", N, K);
+        return -1;
+    }
+    const int64_t ne10_padded = GGML_PAD((int64_t)K, MATRIX_ROW_PADDING);
+    quantize_row_q8_1_hip(
+        X_f32, nullptr, X_q8, GGML_TYPE_Q8_0, K,
+        (int64_t)K, (int64_t)K * N, (int64_t)K * N,
+        ne10_padded, N, 1, 1, stream);
+    return hipGetLastError() == hipSuccess ? 0 : -2;
+}
+
+// The 320-row HC down projection has too few waves to hide its long K
+// loads. Fetch two iterations together, retaining the MMVQ sum order.
+template<int tokens, bool grouped = false>
+__launch_bounds__(32) __global__ static void qfn_q8_hc_down_kernel(
+        const block_q8_0* __restrict__ weights,
+        const block_q8_1* __restrict__ input, float* __restrict__ output) {
+    constexpr int blocks = 10240 / QK8_0;
+    constexpr int prefetch = 2;
+    if constexpr (grouped) {
+        input += size_t(blockIdx.y) * tokens * blocks;
+        output += size_t(blockIdx.y) * tokens * 320;
+    }
+    const int lane = threadIdx.x;
+    const int part = (lane & 3) * 2;
+    float sum[tokens] = {};
+    for (int first = lane / 4; first < blocks; first += 8 * prefetch) {
+        int v[prefetch][2], u[prefetch][tokens][2];
+        half dw[prefetch], dx[prefetch][tokens];
+#pragma unroll
+        for (int j = 0; j < prefetch; ++j) {
+            const int kb = first + 8 * j;
+            const auto& w = weights[blockIdx.x * blocks + kb];
+            dw[j] = w.d;
+#pragma unroll
+            for (int i = 0; i < 2; ++i)
+                v[j][i] = get_int_b2(w.qs, part + i);
+#pragma unroll
+            for (int t = 0; t < tokens; ++t) {
+                const auto& x = input[t * blocks + kb];
+                dx[j][t] = __low2half(x.ds);
+#pragma unroll
+                for (int i = 0; i < 2; ++i)
+                    u[j][t][i] = get_int_b4(x.qs, part + i);
+            }
+        }
+        __builtin_amdgcn_sched_barrier(0);
+#pragma unroll
+        for (int j = 0; j < prefetch; ++j) {
+#pragma unroll
+            for (int t = 0; t < tokens; ++t) {
+                int dot = ggml_hip_dp4a(v[j][0], u[j][t][0], 0);
+                dot = ggml_hip_dp4a(v[j][1], u[j][t][1], dot);
+                if constexpr (tokens == 1) {
+                    const float scale =
+                        __fmul_rn(__half2float(dw[j]), __half2float(dx[j][t]));
+                    const float product = __fmul_rn(scale, static_cast<float>(dot));
+                    sum[t] = __fadd_rn(sum[t], product);
+                } else {
+                    // Preserve the batched MMVQ weight-dot rounding and
+                    // input-scale FMA; reassociating the scales changes logits.
+                    const float product =
+                        __fmul_rn(__half2float(dw[j]), static_cast<float>(dot));
+                    sum[t] = __fmaf_rn(__half2float(dx[j][t]), product, sum[t]);
+                }
+            }
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < tokens; ++t) {
+        sum[t] = warp_reduce_sum<32>(sum[t]);
+        if (lane == 0) output[t * 320 + blockIdx.x] = sum[t];
+    }
+}
+
+template<int tokens = 1>
+static void launch_q8_hc_down(const void* weights, const void* input,
+                              float* output, int rows, hipStream_t stream) {
+    if (rows == tokens) {
+        qfn_q8_hc_down_kernel<tokens><<<320, 32, 0, stream>>>(
+            static_cast<const block_q8_0*>(weights),
+            static_cast<const block_q8_1*>(input), output);
+    } else if constexpr (tokens < MMVQ_MAX_BATCH_SIZE) {
+        launch_q8_hc_down<tokens + 1>(weights, input, output, rows, stream);
+    }
+}
+
+// One wave owns one output row and N = 2, 3, or 4 verification rows.
+// Weight quants are decoded once per K block and reused; each row keeps its
+// own Q8_1 scale and the MMVQ product (d_w * d_x) * dot, added in K order.
+static unsigned long long g_q8_shallow_launches = 0;
+
+extern "C" void qfn_q8_shallow_reset(void) { g_q8_shallow_launches = 0; }
+
+extern "C" unsigned long long qfn_q8_shallow_launches(void) {
+  return g_q8_shallow_launches;
+}
+
+template<int tokens, bool has_gate>
+__launch_bounds__(32) __global__ static void qfn_q8_shallow_kernel(
+    const block_q8_0* __restrict__ weights,
+    const block_q8_0* __restrict__ gate,
+    const block_q8_1* __restrict__ input, float* __restrict__ output, int k,
+    int rows, int stride) {
+  const int lane = threadIdx.x;
+  const int row = blockIdx.x;
+  const int blocks = k / QK8_0;
+  const int part = (lane & 3) * 2;
+  const block_q8_0* wrow = weights + static_cast<int64_t>(row) * blocks;
+  const block_q8_0* grow =
+      has_gate ? gate + static_cast<int64_t>(row) * blocks : nullptr;
+  float sum[tokens] = {};
+  float gate_sum[tokens] = {};
+  // Same K order as MMVQ. Decode each weight block once per K step and
+  // reuse those quants for every verification row.
+  for (int kb = lane / 4; kb < blocks; kb += 8) {
+    const block_q8_0& w = wrow[kb];
+    const float dw = __half2float(w.d);
+    const int v[2] = {get_int_b2(w.qs, part), get_int_b2(w.qs, part + 1)};
+    int gv[2] = {};
+    float dg = 0.F;
+    if constexpr (has_gate) {
+      const block_q8_0& a = grow[kb];
+      dg = __half2float(a.d);
+      gv[0] = get_int_b2(a.qs, part);
+      gv[1] = get_int_b2(a.qs, part + 1);
+    }
+#pragma unroll
+    for (int t = 0; t < tokens; ++t) {
+      const block_q8_1& x = input[t * stride + kb];
+      const int u[2] = {get_int_b4(x.qs, part), get_int_b4(x.qs, part + 1)};
+      const float dx = __half2float(__low2half(x.ds));
+      sum[t] += vec_dot_q8_0_q8_1_impl<float, VDR_Q8_0_Q8_1_MMVQ>(v, u, dw, dx);
+      if constexpr (has_gate) {
+        gate_sum[t] +=
+            vec_dot_q8_0_q8_1_impl<float, VDR_Q8_0_Q8_1_MMVQ>(gv, u, dg, dx);
+      }
+    }
+  }
+#pragma unroll
+  for (int t = 0; t < tokens; ++t) {
+    sum[t] = warp_reduce_sum<32>(sum[t]);
+    if constexpr (has_gate) gate_sum[t] = warp_reduce_sum<32>(gate_sum[t]);
+    if (lane == 0) {
+      float value = sum[t];
+      if constexpr (has_gate)
+        value *= gate_sum[t] / (1.0f + expf(-gate_sum[t]));
+      output[t * rows + row] = value;
+    }
+  }
+}
+
+template<int tokens>
+static int launch_q8_shallow(const void* weights, const void* gate,
+                             const void* input, float* output, int k, int rows,
+                             int stride, hipStream_t stream) {
+  if (gate) {
+    qfn_q8_shallow_kernel<tokens, true><<<rows, 32, 0, stream>>>(
+        static_cast<const block_q8_0*>(weights),
+        static_cast<const block_q8_0*>(gate),
+        static_cast<const block_q8_1*>(input), output, k, rows, stride);
+  } else {
+    qfn_q8_shallow_kernel<tokens, false><<<rows, 32, 0, stream>>>(
+        static_cast<const block_q8_0*>(weights), nullptr,
+        static_cast<const block_q8_1*>(input), output, k, rows, stride);
+  }
+  ++g_q8_shallow_launches;
+  return 0;
+}
+
+extern "C" int qfn_q8_shallow_vec(const void* W, const void* W_gate,
+                                  const void* X_q8, float* out_f32, int M,
+                                  int N, int K, hipStream_t stream) {
+  if (!W || !X_q8 || !out_f32 || M <= 0 || N < 1 || N > 4 || K <= 0 ||
+      K % 32 != 0) {
+    return -1;
+  }
+  const int stride = GGML_PAD(K, MATRIX_ROW_PADDING) / QK8_1;
+  switch (N) {
+    case 1:
+      return launch_q8_shallow<1>(W, W_gate, X_q8, out_f32, K, M, stride, stream);
+    case 2:
+      return launch_q8_shallow<2>(W, W_gate, X_q8, out_f32, K, M, stride, stream);
+    case 3:
+      return launch_q8_shallow<3>(W, W_gate, X_q8, out_f32, K, M, stride, stream);
+    case 4:
+      return launch_q8_shallow<4>(W, W_gate, X_q8, out_f32, K, M, stride, stream);
+    default:
+      return -1;
+  }
+}
+
+extern "C" int qfn_q8_mmvq_reference(const void* W, const void* W_gate,
+                                     const void* X_q8, float* out_f32, int M,
+                                     int N, int K, hipStream_t stream) {
+  if (!W || !X_q8 || !out_f32 || M <= 0 || N < 1 || N > MMVQ_MAX_BATCH_SIZE ||
+      K <= 0 || K % 32 != 0) {
+    return -1;
+  }
+  const int stride = GGML_PAD(K, MATRIX_ROW_PADDING) / QK8_1;
+  mul_mat_vec_q8_dispatch(W, W_gate, static_cast<const block_q8_1*>(X_q8),
+                          out_f32, K, M, N, stride, stream);
+  return hipGetLastError() == hipSuccess ? 0 : -3;
+}
+
+extern "C" int qfn_mmq_q8_0_dense_vec_preq(const void* W, const void* W_gate,
+                                           const void* X_q8, float* out_f32,
+                                           int M, int N, int K,
+                                           hipStream_t stream) {
+  const bool wide_matrix = K == 2560 && M >= 8192 && N <= 48;
+  if (!W || !X_q8 || !out_f32 || M <= 0 || N <= 0 || K <= 0 || K % 32 != 0 ||
+      (N > 32 && !wide_matrix &&
+       (M != 320 || K != 10240 || N % 8 != 0)) ||
+      (N > MMVQ_MAX_BATCH_SIZE && W_gate)) {
+    fprintf(stderr,
+            "qfn_mmq_q8_0_dense_vec_preq: bad arguments M=%d N=%d K=%d\n", M, N,
+            K);
+    return -1;
+  }
+  // Prompt16: only the explicitly scoped target shared-expert down operation.
+  const bool exact_shared_down = M == 2560 && K == 640 &&
+                                 (N == 2 || N == 3) && W_gate == nullptr;
+  const bool candidate_shared_down = exact_shared_down && fnvdown::Use(N);
+  fnvdown::Note(N, candidate_shared_down, exact_shared_down);
+  if (candidate_shared_down)
+    return qfn_q8_mmvq_reference(W, nullptr, X_q8, out_f32, M, N, K, stream);
+  // 320×10240 HC down: the gfx1151 prefetch kernel, including N = 2/3/4.
+  if (N <= MMVQ_MAX_BATCH_SIZE && M == 320 && K == 10240 && W_gate == nullptr) {
+    if (N >= 2 && N <= 4) ++g_q8_shallow_launches;
+    launch_q8_hc_down(W, X_q8, out_f32, N, stream);
+    return hipGetLastError() == hipSuccess ? 0 : -3;
+  }
+  if (N > MMVQ_MAX_BATCH_SIZE && N % 8 == 0 && M == 320 && K == 10240) {
+    qfn_q8_hc_down_kernel<8, true><<<dim3(320, N / 8), 32, 0, stream>>>(
+        static_cast<const block_q8_0*>(W),
+        static_cast<const block_q8_1*>(X_q8), out_f32);
+    return hipGetLastError() == hipSuccess ? 0 : -3;
+  }
+  // Large shallow projections share one decoded weight stream. Small
+  // projections stay on the existing MMVQ; the extra kernel did not win there.
+  if (N >= 2 && N <= 4 && (M >= 2048 || K >= 4096)) {
+    return qfn_q8_shallow_vec(W, W_gate, X_q8, out_f32, M, N, K, stream) == 0 &&
+                   hipGetLastError() == hipSuccess
+               ? 0
+               : -3;
+  }
+  const int input_stride = GGML_PAD(K, MATRIX_ROW_PADDING) / QK8_1;
+  mul_mat_vec_q8_dispatch(W, W_gate, static_cast<const block_q8_1*>(X_q8),
+                          out_f32, K, M, N, input_stride, stream);
+  return hipGetLastError() == hipSuccess ? 0 : -3;
+}
+template void mul_mat_q_case<GGML_TYPE_Q8_0>(
+    ggml_backend_hip_context&, const mmq_args&, hipStream_t);
+template void mul_mat_q_case<GGML_TYPE_Q4_K>(
+    ggml_backend_hip_context&, const mmq_args&, hipStream_t);
+template void mul_mat_q_case<GGML_TYPE_Q5_1>(
+    ggml_backend_hip_context&, const mmq_args&, hipStream_t);
+template void mul_mat_q_case<GGML_TYPE_Q5_K>(
+    ggml_backend_hip_context&, const mmq_args&, hipStream_t);
+} // namespace qfn_mmq
