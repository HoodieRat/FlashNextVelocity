+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <map>
+#include <string_view>
+
+namespace fnvdown {
+// Local Prompt 16 A/B gate. Never changes a graph after capture.
+inline bool candidate = [] { const char* p=std::getenv("FNV_Q8_SHARED_DOWN"); return p && std::string_view(p)=="1"; }();
+inline thread_local bool verification=false;
+inline thread_local bool shared_down=false;
+struct SharedScope { bool before=shared_down; SharedScope(){shared_down=true;} ~SharedScope(){shared_down=before;} };
+struct VerifyScope { bool before; explicit VerifyScope(bool on):before(verification){verification=on;} ~VerifyScope(){verification=before;} };
+using Counts=std::array<std::uint64_t,6>; // baseline shallow exact, candidate, candidate2, candidate3, fallback, exact-shape calls
+struct Round {unsigned rows{}; double wall_ms{},wait_ms{},ple_ms{};};
+struct State {bool active{};Counts executed{},capture_calls{};unsigned rounds{},overflow{},missing_template{},replays{},captures{};std::array<Round,512> round{};};
+inline State state;
+inline std::map<std::uint64_t,Counts> graph_counts;
+inline void Reset(){state={};state.active=true;}
+inline bool Use(int tokens){return candidate && verification && shared_down && (tokens==2 || tokens==3);}
+inline void Note(int tokens,bool selected,bool exact){if(!state.active || !verification || !shared_down)return;
+  if(!exact){++state.executed[4];return;}
+  ++state.executed[5];
+  if(selected){++state.executed[1];++state.executed[tokens==2?2:3];}
+  else ++state.executed[0];
+}
+inline bool VerifyKey(std::uint64_t k){return (k&(1ULL<<32)) && !(k&(1ULL<<40));}
+inline void Capture(std::uint64_t key,const Counts& before){if(!state.active || !VerifyKey(key))return;
+  Counts delta{};for(unsigned i=0;i<6;++i){delta[i]=state.executed[i]-before[i];state.capture_calls[i]+=delta[i];}
+  graph_counts[key]=delta;state.executed=before;++state.captures;
+}
+inline void Replay(std::uint64_t key){if(!state.active || !VerifyKey(key))return;
+  ++state.replays;auto it=graph_counts.find(key);if(it==graph_counts.end()){++state.missing_template;return;}
+  for(unsigned i=0;i<6;++i)state.executed[i]+=it->second[i];
+}
