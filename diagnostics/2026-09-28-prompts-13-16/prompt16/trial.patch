-bool Executor::MtpHaloGreedyChain(
-    Session& session, std::span<const std::int32_t> replay,
-    std::int32_t hidden_row, std::span<std::int32_t> drafts,
-    std::string* error_msg) const {
-  if (drafts.empty() || drafts.size() >= options_.max_speculative ||
-      replay.empty() || replay.size() > options_.max_speculative ||
-      s_.mtp_chain_tokens == nullptr || mtp_chain_host_ == nullptr) {
-    AssignError(error_msg, "invalid async halo MTP chain request");
-    return false;
-  }
-  // The first graph consumes the ordinary catch-up replay. Later graphs read
-  // the previous argmax directly from the contiguous GPU token chain. No D2H
-  // transfer is inserted between predictor steps; after every step is queued,
-  // one bulk token download and one stream synchronization publish the chain.
-  for (std::size_t i = 0; i < drafts.size(); ++i) {
-    const bool first = i == 0;
-    const auto host_tokens = first
-                                 ? std::span<const std::int32_t>(replay)
-                                 : std::span<const std::int32_t>{};
-    const auto* device_token =
-        first ? nullptr : s_.mtp_chain_tokens + (i - 1);
-    if (!MtpForwardQueued(session, host_tokens, first ? hidden_row : -1,
-                          true, false, error_msg, nullptr, nullptr,
-                          device_token, static_cast<std::int32_t>(i), false)) {
-      return false;
-    }
-  }
-  if (!Check(hipMemcpyAsync(mtp_chain_host_, s_.mtp_chain_tokens,
-                            drafts.size_bytes(), hipMemcpyDeviceToHost, stream_),
-             "async MTP chain download", error_msg) ||
-      !Check(fnvprof::TimedStreamSync(stream_, hipStreamSynchronize),
-             "async MTP chain", error_msg)) {
-    return false;
-  }
-  std::copy_n(mtp_chain_host_, drafts.size(), drafts.begin());
-  return true;
-}
