+
+struct VerifyGpuSpan {
+  hipStream_t stream{nullptr};
+  fnvprof::VerifySubstage stage{fnvprof::VerifySubstage::Trunk};
+  int begin{-1};
+  bool finished{false};
+  VerifyGpuSpan(hipStream_t stream_in, fnvprof::VerifySubstage stage_in,
