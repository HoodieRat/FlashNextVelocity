-std::span<const float> Executor::FullVerificationLogits(
-    std::uint32_t rows) const noexcept {
-  const auto count = std::min<std::uint32_t>(rows, options_.max_logit_rows);
-  return {logits_host_, static_cast<std::size_t>(count) * config().vocab_size};
-}
-
-std::span<const float> Executor::VerificationLogitRow(
-    std::uint32_t row) const noexcept {
-  if (logits_host_ == nullptr || row >= options_.max_logit_rows) return {};
-  const auto vocab = config().vocab_size;
-  return {logits_host_ + static_cast<std::size_t>(row) * vocab, vocab};
-}
-
-std::span<const MtpVerificationCandidateLogits>
-Executor::CompactVerificationCandidates(std::uint32_t rows) const noexcept {
-  const auto count = std::min<std::uint32_t>(rows, options_.max_speculative);
-  return {mtp_verify_candidates_host_, count};
