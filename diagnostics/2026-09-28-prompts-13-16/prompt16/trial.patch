-  // preceding layers before waiting, including on captured graph replay.
-  // Both pieces use the same stream and arithmetic as the unsplit graph.
-  const std::uint32_t first_layer =
-      graph && c.ple_layer > 0 ? static_cast<std::uint32_t>(c.ple_layer) : 0;
-  if (first_layer > 0) {
-    const auto prefix = [&] {
-      return ForwardBody(session, n, 0, false, 0, speculative, sparse,
-                         start_pos, graph_pool_grid, 0, first_layer, error_msg);
-    };
-    constexpr std::uint64_t kPrefixKey = std::uint64_t{1} << 35;
-    if (!Run(session, key | kPrefixKey, graph, prefix, error_msg, false)) {
-      return false;
-    }
-  }
-  const auto body = [&] {
-    return ForwardBody(session, n, n_logits, download_logits,
-                       compact_candidates, speculative, sparse, start_pos,
-                       graph ? graph_pool_grid : pool_grid, first_layer,
-                       c.num_layers, error_msg);
-  };
-  // Only the suffix waits for its pinned n-gram rows. During eager
-  // execution and capture, Ple performs this wait at the same boundary.
-  // The lookup must use Run's effective (possibly profiled) key: a graph
-  // from the unprofiled warmup does not mean this suffix will replay.
-  if (graph && session.graphs_.contains(key) && ple_pending_ &&
-      !WaitPle(error_msg)) {
-    return false;
-  }
-  const bool flag_wait = graph && done_flag_ != nullptr;
-  if (!Run(session, key, graph, body, error_msg, !flag_wait) ||
-      (flag_wait && !Wait("forward", error_msg))) {
-    return false;
-  }
-  if (speculative) {
-    // Decode graphs replay without executing ForwardBody on the host, so the
-    // substage event samples are intentionally eager-only. The counters and
-    // transfer bytes remain complete.
-    if (graph) fnvprof::SetVerifyGpuEventsIncomplete();
-    VerifyGpuCollect();
-  }
-  if (n_logits > 0 && logits != nullptr) {
-    std::copy_n(logits_host_, static_cast<std::size_t>(n_logits) * c.vocab_size,
-                logits);
-  }
-
-  session.position_ += n;
-  if (sparse) {
-    session.blocks_ = complete;
-  }
-  if (session.mtp_enabled_ && prefill_phase && n > 1) {
-    // Every successor except the last one is already known. Consume it while
-    // the trunk residual is still in shared scratch. MtpBody reads that
-    // residual into xn before reusing res for the predictor output.
-    PrefillPhase draft_phase(false);
-    if (!MtpForward(session, tokens.subspan(1), 0, {}, error_msg, s_.res))
-      return false;
-  }
-  return true;
-}
-
-bool Executor::ForwardBody(Session& session, std::uint32_t n,
-                           std::uint32_t n_logits, bool download_logits,
-                           std::uint32_t compact_candidates, bool speculative,
-                           bool sparse,
-                           std::uint32_t start_pos, std::uint32_t pool_grid,
-                           std::uint32_t first_layer, std::uint32_t end_layer,
-                           std::string* error_msg) const {
-  const Config& c = config();
-  VerifyGpuSpan verify_trunk(stream_, fnvprof::VerifySubstage::Trunk,
-                             speculative && fnvprof::OnDecode());
-  if (first_layer == 0) {
-    if (!Check(hipMemcpyAsync(session.control_, control_host_,
-                              sizeof(Session::Control), hipMemcpyHostToDevice,
-                              stream_),
-               "control upload", error_msg) ||
-        !Check(hipMemcpyAsync(s_.tokens, tokens_host_, n * sizeof(std::int32_t),
-                              hipMemcpyHostToDevice, stream_),
-               "token upload", error_msg)) {
-      return false;
-    }
-    EmbedTokens(model_->token_embd().data, SmallType(model_->token_embd().type),
-                s_.tokens, s_.res, n, c.hidden_size, c.hc_count, stream_);
-    session.vision_input_.Inject(s_.res, start_pos, n, c.hidden_size,
-                                 c.hc_count, stream_);
-  }
-  const auto& layers = model_->layers();
-  bool normed = false;  ///< xn holds the next mixer's grouped norm of res
-  for (std::uint32_t il = first_layer; il < end_layer; ++il) {
-    if (!session.CheckCancellation(error_msg))
-      return false;
-    const DeviceLayer& l = layers[il];
-    if (c.IsPleLayer(il) &&
-        !Ple(l, session, n, s_.res, speculative, error_msg)) {
-      return false;
-    }
-    if (!HcMix(l.hc_attn, s_.res, normed, s_.mixed, s_.inject, n, error_msg)) {
-      return false;
-    }
-    if (l.linear) {
-      if (!LinearAttention(l, session.linear_[il], s_.mixed, s_.block_out, n,
-                           speculative, error_msg)) {
-        return false;
-      }
-    } else if (!Attention(l, session.attention_[il], s_.mixed, s_.block_out, n,
-                          &session.control_->position,
-                          &session.control_->blocks, start_pos, pool_grid,
-                          session.max_context_, sparse, error_msg)) {
-      return false;
-    }
-
-    // Each combine also norms the residual for the mixer that follows it,
-    // unless PLE rewrites the residual first.
-    Combine(s_.res, l.hc_ffn.norm.f32(), n);
-    if (!HcMix(l.hc_ffn, s_.res, true, s_.mixed, s_.inject, n, error_msg) ||
-        !Moe(l, s_.mixed, s_.block_out, n, error_msg)) {
-      return false;
-    }
-    const float* next_norm =
-        il + 1 < c.num_layers
-            ? (c.IsPleLayer(il + 1) ? nullptr
-                                    : layers[il + 1].hc_attn.norm.f32())
-            : model_->hc_head().norm.f32();
-    Combine(s_.res, next_norm, n);
-    normed = next_norm != nullptr;
-  }
-  verify_trunk.Finish();
-  if (end_layer < c.num_layers) {
-    return true;
-  }
-  // Prefill catches up immediately from shared scratch. Only the short tail
-  // needed across calls belongs to this session.
-  const auto kept = std::min(n, options_.max_speculative);
-  if (session.mtp_enabled_ &&
-      !Check(hipMemcpyAsync(
-                 session.mtp_.target_hidden,
-                 s_.res + static_cast<std::size_t>(n - kept) * c.HcDim(),
-                 static_cast<std::size_t>(kept) * c.HcDim() * sizeof(float),
-                 hipMemcpyDeviceToDevice, stream_),
-             "hidden keep", error_msg)) {
-    return false;
-  }
-  if (n_logits > 0) {
-    PrefillPhase head_phase(false);
-    // The head mixer norms its tail rows itself: the last combine's norm is
-    // laid out for the whole batch (and tiled on the wide route), so a row
-    // offset into it is not addressable.
-    const std::size_t skip = static_cast<std::size_t>(n - n_logits);
-    const DeviceMixer& head = model_->hc_head();
-    {
-      VerifyGpuSpan head_span(stream_, fnvprof::VerifySubstage::HcHead,
-                              speculative && fnvprof::OnDecode());
-      if (!HcMix(head, s_.res + skip * c.HcDim(), false, s_.mixed, nullptr,
-                 n_logits, error_msg)) {
-        return false;
-      }
-    }
-    {
-      VerifyGpuSpan projection_span(
-          stream_, fnvprof::VerifySubstage::VocabProjection,
-          speculative && fnvprof::OnDecode());
-      if (!Dense(model_->output(), s_.mixed, s_.logits, n_logits, error_msg)) {
-        return false;
-      }
-    }
-    if (compact_candidates != 0) {
-      if (!speculative || mtp_verify_candidates_host_ == nullptr ||
-          n_logits < 2) {
-        AssignError(error_msg, "compact verification transfer is unavailable");
-        return false;
-      }
-      const auto count =
-          std::min<std::size_t>(c.vocab_size, compact_candidates);
-      static_assert(offsetof(MtpVerificationCandidateLogits, logits) ==
-                    kMtpVerificationCandidates * sizeof(std::uint32_t));
-      const auto bytes = offsetof(MtpVerificationCandidateLogits, logits) +
-                         count * sizeof(float);
-      auto* verify_scores = reinterpret_cast<float*>(
-          s_.mtp_ids + kMtpVerificationCandidates);
-      for (std::uint32_t row = 0; row < n_logits; ++row) {
-        {
-          VerifyGpuSpan select_span(
-              stream_, fnvprof::VerifySubstage::CompactSelect,
-              fnvprof::OnDecode());
-          const auto* row_logits =
-              s_.logits + static_cast<std::size_t>(row) * c.vocab_size;
-          switch (compact_candidates) {
-            case 64:
-              MtpTopVerificationCandidates64(
-                  row_logits, s_.mtp_ids, s_.mtp_scratch_ids, verify_scores,
-                  c.vocab_size, stream_);
-              break;
-            case 128:
-              MtpTopVerificationCandidates128(
-                  row_logits, s_.mtp_ids, s_.mtp_scratch_ids, verify_scores,
-                  c.vocab_size, stream_);
-              break;
-            case kMtpVerificationCandidates:
-              MtpTopVerificationCandidates256(
-                  row_logits, s_.mtp_ids, s_.mtp_scratch_ids, verify_scores,
-                  c.vocab_size, stream_);
-              break;
-            default:
-              AssignError(error_msg,
-                          "unsupported compact verification candidate width");
-              return false;
-          }
-        }
-        // Selector output is reused by the next row, so enqueue its compact
-        // transfer before selecting the next row. All operations remain on
-        // the same stream and preserve graph ordering.
-        VerifyGpuSpan d2h_span(stream_, fnvprof::VerifySubstage::D2H,
-                               fnvprof::OnDecode());
-        if (!Check(hipMemcpyAsync(mtp_verify_candidates_host_ + row, s_.mtp_ids,
-                                  bytes, hipMemcpyDeviceToHost, stream_),
-                   "compact verification candidates download", error_msg)) {
-          return false;
-        }
-      }
-      // Retain the final full-vocabulary frontier on the owning session. The
-      // next cycle normally samples from the certified compact row; only a
-      // certificate miss downloads this retained row. This removes ~1 MiB of
-      // D2H traffic from every all-accepted verification round.
-      if (session.mtp_.frontier_logits == nullptr ||
-          !Check(hipMemcpyAsync(
-                     session.mtp_.frontier_logits,
-                     s_.logits + static_cast<std::size_t>(n_logits - 1) *
-                                     c.vocab_size,
-                     static_cast<std::size_t>(c.vocab_size) * sizeof(float),
-                     hipMemcpyDeviceToDevice, stream_),
-                 "verification frontier retain", error_msg)) {
-        return false;
-      }
-    } else if (download_logits) {
-      VerifyGpuSpan d2h_span(stream_, fnvprof::VerifySubstage::D2H,
-                             speculative && fnvprof::OnDecode());
-      if (!Check(hipMemcpyAsync(logits_host_, s_.logits,
-                                static_cast<std::size_t>(n_logits) *
-                                    c.vocab_size * sizeof(float),
-                                hipMemcpyDeviceToHost, stream_),
-                 "logits download", error_msg)) {
-        return false;
-      }
-    }
-  }
-  return true;
-}
