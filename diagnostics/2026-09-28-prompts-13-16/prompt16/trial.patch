-__global__ static void qfn_mmq_sanitize_f32_kernel(float *p, uint64_t n) {
-    const uint64_t i = (uint64_t)blockIdx.x * blockDim.x + threadIdx.x;
-    if (i >= n) return;
-    const float v = p[i];
-    if (!isfinite(v)) p[i] = 0.0f;
-}
