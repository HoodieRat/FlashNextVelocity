-bool SendAll(SOCKET socket, std::string_view data) {
-  std::size_t offset = 0;
-  while (offset < data.size()) {
-    const int n = ::send(socket, data.data() + offset,
-                         static_cast<int>(std::min<std::size_t>(data.size() - offset, 1 << 20)), 0);
-    if (n <= 0) return false;
-    offset += static_cast<std::size_t>(n);
-  }
-  return true;
-}
